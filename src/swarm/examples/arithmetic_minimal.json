{
  "schema_version": 1,
  "name": "arithmetic_minimal",
  "description": "The smallest complete run: one branch, one criterion, one reviewed answer.",
  "objective": "Establish the total of one integer list and report a reviewed answer.",
  "acceptance_criteria": [
    {
      "id": "c1",
      "description": "the total of the list is correct",
      "verifier_kind": "arithmetic",
      "required": true
    }
  ],
  "permissions": ["arithmetic"],
  "limits": {"concurrency_limit": 2},
  "groups": [{"id": "ga", "tags": ["sums"]}],
  "agents": [
    {"id": "explorer-a", "group_id": "ga"},
    {"id": "critic-1"},
    {"id": "validator-1"},
    {"id": "writer-1"},
    {"id": "judge-1"}
  ],
  "tasks": [
    {
      "id": "ta",
      "numbers": [1, 2, 3],
      "group_id": "ga",
      "tags": ["sums"],
      "acceptance_criterion_ids": ["c1"],
      "required_tools": ["arithmetic"]
    }
  ],
  "provider": {
    "kind": "scripted",
    "final_reviews": [
      {
        "decision": "PASS",
        "summary": "the answer cites validated, tool-verified support for every criterion",
        "checks": ["every cited finding is validated", "criterion c1 is covered"]
      }
    ]
  },
  "expect": {
    "terminal_state": "COMPLETED",
    "exit_code": 0,
    "answer_contains": ["sum([1, 2, 3]) = 6"],
    "criteria_covered": ["c1"],
    "validated_claims": ["sum([1, 2, 3]) = 6"],
    "no_rejected_findings": true,
    "final_review_decisions": ["PASS"],
    "result_versions": 1,
    "gaps": []
  }
}
