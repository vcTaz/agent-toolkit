{
  "schema_version": 1,
  "name": "arithmetic_success",
  "description": "Three branches, two criteria, blocking criticism, selective cross-pollination, a presentation revision, then COMPLETED.",
  "objective": "Establish the totals of three integer lists and report one reviewed answer.",
  "acceptance_criteria": [
    {
      "id": "c1",
      "description": "the totals investigated by the first and third branches are correct",
      "verifier_kind": "arithmetic",
      "required": true
    },
    {
      "id": "c2",
      "description": "the total investigated by the second branch is correct",
      "verifier_kind": "arithmetic",
      "required": true
    }
  ],
  "permissions": ["arithmetic"],
  "limits": {"concurrency_limit": 2},
  "groups": [
    {"id": "ga", "tags": ["sums"]},
    {"id": "gb", "tags": ["sums"]},
    {"id": "gc", "tags": ["sums"]}
  ],
  "agents": [
    {"id": "explorer-a", "group_id": "ga"},
    {"id": "explorer-b", "group_id": "gb"},
    {"id": "explorer-c", "group_id": "gc"},
    {"id": "critic-1"},
    {"id": "validator-1"},
    {"id": "writer-1"},
    {"id": "judge-1"}
  ],
  "tasks": [
    {
      "id": "ta",
      "numbers": [1, 2, 3],
      "group_id": "ga",
      "tags": ["sums"],
      "acceptance_criterion_ids": ["c1"],
      "required_tools": ["arithmetic"]
    },
    {
      "id": "tc",
      "numbers": [4, 5],
      "group_id": "gc",
      "tags": ["sums"],
      "acceptance_criterion_ids": ["c1"],
      "required_tools": ["arithmetic"]
    },
    {
      "id": "tb",
      "numbers": [10, 20],
      "group_id": "gb",
      "tags": ["sums"],
      "acceptance_criterion_ids": ["c2"],
      "required_tools": ["arithmetic"]
    }
  ],
  "provider": {
    "kind": "scripted",
    "critiques": [
      {
        "claim_contains": "[10, 20]",
        "decision": "CHALLENGE",
        "summary": "the operands are asserted rather than shown to be this task's own list",
        "blocking_issues": ["show that the summed operands are the ones this task was given"]
      }
    ],
    "synthesis": [{"omit_support_matching": "[4, 5]"}],
    "final_reviews": [
      {
        "decision": "REVISE",
        "summary": "criterion c1 has validated support this answer does not present",
        "criterion_ids": ["c1"],
        "blocking_issues": ["one validated total supporting c1 is missing from the answer"]
      },
      {
        "decision": "PASS",
        "summary": "every required criterion is covered by validated, tool-verified support",
        "checks": [
          "every cited finding is validated",
          "criteria c1 and c2 are both covered",
          "no cited claim exceeds its evidence"
        ]
      }
    ]
  },
  "expect": {
    "terminal_state": "COMPLETED",
    "exit_code": 0,
    "answer_contains": ["sum([1, 2, 3]) = 6", "sum([4, 5]) = 9", "sum([10, 20]) = 30"],
    "criteria_covered": ["c1", "c2"],
    "validated_claims": ["sum([1, 2, 3]) = 6", "sum([4, 5]) = 9", "sum([10, 20]) = 30"],
    "no_rejected_findings": true,
    "propagated_to": ["tc"],
    "not_propagated_to": ["tb"],
    "reconsiderations_reported": true,
    "blocking_criticism": true,
    "final_review_decisions": ["REVISE", "PASS"],
    "result_versions": 2,
    "gaps": []
  }
}
