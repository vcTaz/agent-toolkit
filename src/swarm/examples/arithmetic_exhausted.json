{
  "schema_version": 1,
  "name": "arithmetic_exhausted",
  "description": "One branch asserts a total the trusted verifier refuses; bounded repair repeats it and the run ends EXHAUSTED with its partial knowledge intact.",
  "objective": "Establish the totals of three integer lists and report one reviewed answer.",
  "acceptance_criteria": [
    {
      "id": "c1",
      "description": "the totals investigated by the first and third branches are correct",
      "verifier_kind": "arithmetic",
      "required": true
    },
    {
      "id": "c2",
      "description": "the total investigated by the second branch is correct",
      "verifier_kind": "arithmetic",
      "required": true
    }
  ],
  "permissions": ["arithmetic"],
  "limits": {"concurrency_limit": 2},
  "groups": [
    {"id": "ga", "tags": ["sums"]},
    {"id": "gb", "tags": ["sums"]},
    {"id": "gc", "tags": ["sums"]}
  ],
  "agents": [
    {"id": "explorer-a", "group_id": "ga"},
    {"id": "explorer-b", "group_id": "gb"},
    {"id": "explorer-c", "group_id": "gc"},
    {"id": "critic-1"},
    {"id": "validator-1"},
    {"id": "writer-1"},
    {"id": "judge-1"}
  ],
  "tasks": [
    {
      "id": "ta",
      "numbers": [1, 2, 3],
      "group_id": "ga",
      "tags": ["sums"],
      "acceptance_criterion_ids": ["c1"],
      "required_tools": ["arithmetic"]
    },
    {
      "id": "tc",
      "numbers": [4, 5],
      "group_id": "gc",
      "tags": ["sums"],
      "acceptance_criterion_ids": ["c1"],
      "required_tools": ["arithmetic"]
    },
    {
      "id": "tb",
      "numbers": [10, 20],
      "group_id": "gb",
      "tags": ["sums"],
      "acceptance_criterion_ids": ["c2"],
      "required_tools": ["arithmetic"]
    }
  ],
  "provider": {
    "kind": "scripted",
    "claims": {"tb": 99},
    "repairs": {"c2": {"numbers": [10, 20], "total": 99}}
  },
  "expect": {
    "terminal_state": "EXHAUSTED",
    "exit_code": 1,
    "no_result": true,
    "result_versions": 0,
    "criteria_covered": ["c1"],
    "validated_claims": ["sum([1, 2, 3]) = 6", "sum([4, 5]) = 9"],
    "rejected_claims": ["sum([10, 20]) = 99"],
    "gaps": ["c2:UNSUPPORTED"],
    "stop_reason_contains": "c2",
    "repair_attempted": true
  }
}
